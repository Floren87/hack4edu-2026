NODE_ENV=development
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
DATABASE_URL=file:./demo.db
# Solo para libsql:// remoto; nunca usar VITE_ ni compartir el token con el navegador.
DATABASE_AUTH_TOKEN=
# Opcional: directorio absoluto del build de app para servir UI y API en un origen.
STATIC_DIR=
